@model TransportApp.Models.RouteInfo
@{
    ViewData["Title"] = Model.RouteName;
}

<div class="min-h-screen py-8 px-4">
    <div class="max-w-4xl mx-auto">
        <a href="/Transport" class="inline-flex items-center text-primary hover:underline mb-6">
            <i class="fas fa-arrow-left mr-2"></i>Servis Listesine Dön
        </a>

        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl overflow-hidden">
            <div class="p-8 bg-gradient-to-r from-primary to-secondary text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <span class="px-3 py-1 bg-white/20 rounded-full text-sm">
                            <i class="fas @(Model.VehicleType == "Taksi" ? "fa-taxi" : Model.VehicleType == "Belediye Servisi" ? "fa-bus" : "fa-shuttle-van") mr-1"></i>
                            @Model.VehicleType
                        </span>
                        <h1 class="text-3xl font-bold mt-4">@Model.RouteName</h1>
                    </div>
                    <div class="text-right">
                        <p class="text-sm opacity-80">Plaka</p>
                        <p class="text-2xl font-bold">@Model.PlateNumber</p>
                    </div>
                </div>
            </div>

            <div class="p-8">
                <div class="grid md:grid-cols-2 gap-8">
                    <div class="space-y-6">
                        <div>
                            <h3 class="text-lg font-bold mb-3"><i class="fas fa-route mr-2 text-primary"></i>Güzergah</h3>
                            <div class="space-y-3">
                                <div class="flex items-center p-3 bg-green-50 dark:bg-green-900/20 rounded-lg">
                                    <i class="fas fa-map-marker-alt text-green-500 mr-3"></i>
                                    <div>
                                        <p class="text-sm text-gray-500">Kalkış</p>
                                        <p class="font-semibold">@Model.StartPoint</p>
                                    </div>
                                </div>
                                <div class="flex items-center p-3 bg-red-50 dark:bg-red-900/20 rounded-lg">
                                    <i class="fas fa-flag-checkered text-red-500 mr-3"></i>
                                    <div>
                                        <p class="text-sm text-gray-500">Varış</p>
                                        <p class="font-semibold">@Model.EndPoint</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div>
                            <h3 class="text-lg font-bold mb-3"><i class="fas fa-clock mr-2 text-primary"></i>Saatler</h3>
                            <div class="grid grid-cols-2 gap-4">
                                <div class="p-3 bg-gray-50 dark:bg-gray-700 rounded-lg text-center">
                                    <p class="text-sm text-gray-500">Kalkış</p>
                                    <p class="text-xl font-bold text-primary">@Model.DepartureTime</p>
                                </div>
                                <div class="p-3 bg-gray-50 dark:bg-gray-700 rounded-lg text-center">
                                    <p class="text-sm text-gray-500">Varış</p>
                                    <p class="text-xl font-bold text-secondary">@Model.ArrivalTime</p>
                                </div>
                            </div>
                            <p class="mt-2 text-sm text-gray-500">
                                <i class="fas fa-sync-alt mr-1"></i>Sıklık: @Model.Frequency
                            </p>
                        </div>
                    </div>

                    <div class="space-y-6">
                        <div>
                            <h3 class="text-lg font-bold mb-3"><i class="fas fa-user mr-2 text-primary"></i>Şoför Bilgileri</h3>
                            <div class="p-4 bg-gray-50 dark:bg-gray-700 rounded-lg">
                                <p class="font-semibold"><i class="fas fa-id-card mr-2"></i>@Model.DriverName</p>
                                <p class="text-gray-500"><i class="fas fa-phone mr-2"></i>@Model.DriverPhone</p>
                            </div>
                        </div>

                        <div>
                            <h3 class="text-lg font-bold mb-3"><i class="fas fa-map-signs mr-2 text-primary"></i>Duraklar</h3>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var stop in Model.Stops.Split(','))
                                {
                                    <span class="px-3 py-1 bg-primary/10 text-primary rounded-full text-sm">
                                        <i class="fas fa-map-pin mr-1"></i>@stop.Trim()
                                    </span>
                                }
                            </div>
                        </div>

                        @if (Model.Price.HasValue)
                        {
                            <div class="p-4 bg-primary/10 rounded-lg text-center">
                                <p class="text-sm text-gray-500">Ücret</p>
                                <p class="text-3xl font-bold text-primary">@Model.Price.Value.ToString("C2")</p>
                            </div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mt-8 p-4 bg-yellow-50 dark:bg-yellow-900/20 rounded-lg">
                        <h3 class="font-bold mb-2"><i class="fas fa-sticky-note mr-2 text-yellow-500"></i>Notlar</h3>
                        <p class="text-gray-600 dark:text-gray-300">@Model.Notes</p>
                    </div>
                }

                <!-- Harita -->
                <div class="mt-8">
                    <h3 class="text-lg font-bold mb-3"><i class="fas fa-map mr-2 text-primary"></i>Harita</h3>
                    <div class="h-64 rounded-lg overflow-hidden border border-gray-200 dark:border-gray-600">
                        <iframe 
                            src="https://www.openstreetmap.org/export/embed.html?bbox=30.95%2C40.85%2C31.25%2C41.05&layer=mapnik&marker=40.95%2C31.10" 
                            width="100%" 
                            height="100%" 
                            style="border:0;" 
                            allowfullscreen 
                            loading="lazy">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
