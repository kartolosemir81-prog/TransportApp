@model List<TransportApp.Models.RouteInfo>
@{
    ViewData["Title"] = "Servisler";
    var vehicleTypes = ViewBag.VehicleTypes as List<string> ?? new();
}

<div class="min-h-screen py-8 px-4">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold mb-4">
                <i class="fas fa-bus mr-3 text-primary"></i>Servisler
            </h1>
            <p class="text-gray-500">Taksi, belediye servisi ve minibüs güzergahları, saatleri ve durakları</p>
        </div>

        <!-- Filtreler -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 mb-8">
            <form method="get" class="flex flex-wrap gap-4 items-end">
                <div class="flex-1 min-w-[200px]">
                    <label class="block text-sm font-medium mb-2">Ara</label>
                    <input type="text" name="search" value="@ViewBag.Search" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary" placeholder="Güzergah, durak ara..." />
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Araç Tipi</label>
                    <select name="vehicleType" class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary">
                        <option value="">Tümü</option>
                        @foreach (var type in vehicleTypes)
                        {
                            <option value="@type" selected="@(ViewBag.SelectedType == type)">@type</option>
                        }
                    </select>
                </div>
                <button type="submit" class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors">
                    <i class="fas fa-search mr-2"></i>Filtrele
                </button>
            </form>
        </div>

        <!-- Sonuçlar -->
        @if (Model.Any())
        {
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var route in Model)
                {
                    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all transform hover:-translate-y-1">
                        <div class="p-6">
                            <div class="flex items-center justify-between mb-4">
                                <span class="px-3 py-1 rounded-full text-xs font-semibold
                                    @(route.VehicleType == "Taksi" ? "bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-300" :
                                      route.VehicleType == "Belediye Servisi" ? "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300" :
                                      "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300")">
                                    <i class="fas @(route.VehicleType == "Taksi" ? "fa-taxi" : route.VehicleType == "Belediye Servisi" ? "fa-bus" : "fa-shuttle-van") mr-1"></i>
                                    @route.VehicleType
                                </span>
                                <span class="text-sm text-gray-500">
                                    <i class="fas fa-clock mr-1"></i>@route.DepartureTime
                                </span>
                            </div>
                            <h3 class="text-xl font-bold mb-2">@route.RouteName</h3>
                            <div class="space-y-2 mb-4">
                                <div class="flex items-center text-sm">
                                    <i class="fas fa-map-marker-alt text-green-500 mr-2 w-4"></i>
                                    <span>@route.StartPoint</span>
                                </div>
                                <div class="flex items-center text-sm">
                                    <i class="fas fa-flag-checkered text-red-500 mr-2 w-4"></i>
                                    <span>@route.EndPoint</span>
                                </div>
                            </div>
                            <div class="flex items-center justify-between text-sm text-gray-500 mb-4">
                                <span><i class="fas fa-sync-alt mr-1"></i>@route.Frequency</span>
                                @if (route.Price.HasValue)
                                {
                                    <span class="font-semibold text-primary">@route.Price.Value.ToString("C2")</span>
                                }
                            </div>
                            <a href="/Transport/Details/@route.Id" class="block w-full py-2 text-center bg-primary/10 text-primary rounded-lg hover:bg-primary hover:text-white transition-colors">
                                <i class="fas fa-info-circle mr-2"></i>Detayları Gör
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-12 text-gray-500">
                <i class="fas fa-bus text-6xl mb-4"></i>
                <p class="text-xl">Servis bulunamadı.</p>
            </div>
        }
    </div>
</div>
