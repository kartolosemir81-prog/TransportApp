@model TransportApp.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "Admin Panel";
}

<div class="min-h-screen bg-gray-100 dark:bg-gray-900 py-8">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex items-center justify-between mb-8">
            <h1 class="text-3xl font-bold">
                <i class="fas fa-tachometer-alt mr-3 text-primary"></i>Admin Panel
            </h1>
            <a href="/" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">
                <i class="fas fa-arrow-left mr-2"></i>Siteye Dön
            </a>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
            <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg">
                <div class="flex items-center">
                    <div class="w-12 h-12 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center mr-4">
                        <i class="fas fa-users text-blue-500 text-xl"></i>
                    </div>
                    <div>
                        <p class="text-gray-500 text-sm">Toplam Kullanıcı</p>
                        <p class="text-2xl font-bold">@Model.TotalUsers</p>
                    </div>
                </div>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg">
                <div class="flex items-center">
                    <div class="w-12 h-12 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center mr-4">
                        <i class="fas fa-bus text-green-500 text-xl"></i>
                    </div>
                    <div>
                        <p class="text-gray-500 text-sm">Toplam Servis</p>
                        <p class="text-2xl font-bold">@Model.TotalRoutes</p>
                    </div>
                </div>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg">
                <div class="flex items-center">
                    <div class="w-12 h-12 rounded-lg bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center mr-4">
                        <i class="fas fa-check-circle text-purple-500 text-xl"></i>
                    </div>
                    <div>
                        <p class="text-gray-500 text-sm">Aktif Servis</p>
                        <p class="text-2xl font-bold">@Model.ActiveRoutes</p>
                    </div>
                </div>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg">
                <div class="flex items-center">
                    <div class="w-12 h-12 rounded-lg bg-yellow-100 dark:bg-yellow-900/30 flex items-center justify-center mr-4">
                        <i class="fas fa-envelope text-yellow-500 text-xl"></i>
                    </div>
                    <div>
                        <p class="text-gray-500 text-sm">Mesaj</p>
                        <p class="text-2xl font-bold">@Model.TotalMessages</p>
                    </div>
                </div>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg">
                <div class="flex items-center">
                    <div class="w-12 h-12 rounded-lg bg-red-100 dark:bg-red-900/30 flex items-center justify-center mr-4">
                        <i class="fas fa-envelope-open text-red-500 text-xl"></i>
                    </div>
                    <div>
                        <p class="text-gray-500 text-sm">Okunmamış</p>
                        <p class="text-2xl font-bold">@Model.UnreadMessages</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="grid md:grid-cols-3 gap-6">
            <a href="/Admin/Routes" class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1">
                <div class="flex items-center">
                    <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mr-4">
                        <i class="fas fa-bus text-primary text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold">Servisleri Yönet</h3>
                        <p class="text-sm text-gray-500">Servis ekle, düzenle, sil</p>
                    </div>
                </div>
            </a>
            <a href="/Admin/Messages" class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1">
                <div class="flex items-center">
                    <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mr-4">
                        <i class="fas fa-inbox text-primary text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold">Mesajlar</h3>
                        <p class="text-sm text-gray-500">Gelen mesajları görüntüle</p>
                    </div>
                </div>
            </a>
            <a href="/swagger" target="_blank" class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1">
                <div class="flex items-center">
                    <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mr-4">
                        <i class="fas fa-code text-primary text-xl"></i>
                    </div>
                    <div>
                        <h3 class="font-bold">API Dokümantasyonu</h3>
                        <p class="text-sm text-gray-500">Swagger UI'ı aç</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
