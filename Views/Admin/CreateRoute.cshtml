@model TransportApp.Models.RouteInfo
@{
    ViewData["Title"] = "Yeni Servis";
}

<div class="min-h-screen bg-gray-100 dark:bg-gray-900 py-8">
    <div class="max-w-3xl mx-auto px-4">
        <div class="flex items-center justify-between mb-8">
            <h1 class="text-3xl font-bold">
                <i class="fas fa-plus-circle mr-3 text-primary"></i>Yeni Servis
            </h1>
            <a href="/Admin/Routes" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">
                <i class="fas fa-arrow-left mr-2"></i>Geri
            </a>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-8">
            <form asp-action="CreateRoute" method="post" class="space-y-6">
                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium mb-2">Güzergah Adı</label>
                        <input asp-for="RouteName" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary" placeholder="Akçakoca - Düzce" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-2">Araç Tipi</label>
                        <select asp-for="VehicleType" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary">
                            <option value="">Seçin</option>
                            <option value="Taksi">Taksi</option>
                            <option value="Belediye Servisi">Belediye Servisi</option>
                            <option value="Minibüs">Minibüs</option>
                        </select>
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium mb-2">Plaka</label>
                        <input asp-for="PlateNumber" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary" placeholder="41 ABC 123" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-2">Ücret (TL)</label>
                        <input asp-for="Price" type="number" step="0.01" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary" placeholder="0.00" />
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium mb-2">Şoför Adı</label>
                        <input asp-for="DriverName" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary" placeholder="Ad Soyad" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-2">Şoför Telefonu</label>
                        <input asp-for="DriverPhone" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary" placeholder="05xx xxx xx xx" />
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium mb-2">Başlangıç Noktası</label>
                        <input asp-for="StartPoint" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary" placeholder="Akçakoca Otogar" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-2">Bitiş Noktası</label>
                        <input asp-for="EndPoint" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary" placeholder="Düzce Otogar" />
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-medium mb-2">Kalkış Saati</label>
                        <input asp-for="DepartureTime" type="time" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-2">Varış Saati</label>
                        <input asp-for="ArrivalTime" type="time" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary" />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-2">Sıklık</label>
                    <input asp-for="Frequency" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary" placeholder="Her 15 dakika" />
                </div>

                <div>
                    <label class="block text-sm font-medium mb-2">Duraklar (virgülle ayırın)</label>
                    <textarea asp-for="Stops" rows="3" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary resize-none" placeholder="Akçakoca Otogar, Merkez, Çaylı, Düzce Otogar"></textarea>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-2">Notlar</label>
                    <textarea asp-for="Notes" rows="2" class="w-full px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-transparent focus:ring-2 focus:ring-primary resize-none" placeholder="Ek bilgiler..."></textarea>
                </div>

                <div class="flex items-center">
                    <input asp-for="IsActive" type="checkbox" checked class="w-4 h-4 rounded border-gray-300 text-primary focus:ring-primary" />
                    <label class="ml-2 text-sm text-gray-600 dark:text-gray-400">Aktif (sitede gösterilsin)</label>
                </div>

                <button type="submit" class="w-full py-3 bg-primary text-white rounded-lg hover:bg-secondary transition-colors font-semibold">
                    <i class="fas fa-save mr-2"></i>Servisi Kaydet
                </button>
            </form>
        </div>
    </div>
</div>
