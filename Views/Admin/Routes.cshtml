@model List<TransportApp.Models.RouteInfo>
@{
    ViewData["Title"] = "Servis Yönetimi";
}

<div class="min-h-screen bg-gray-100 dark:bg-gray-900 py-8">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex items-center justify-between mb-8">
            <h1 class="text-3xl font-bold">
                <i class="fas fa-bus mr-3 text-primary"></i>Servis Yönetimi
            </h1>
            <div class="flex space-x-4">
                <a href="/Admin/CreateRoute" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-secondary transition-colors">
                    <i class="fas fa-plus mr-2"></i>Yeni Servis
                </a>
                <a href="/Admin" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 rounded-lg hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i>Admin Panel
                </a>
            </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg overflow-hidden">
            <table class="w-full">
                <thead class="bg-gray-50 dark:bg-gray-700">
                    <tr>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600 dark:text-gray-300">Güzergah</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600 dark:text-gray-300">Tip</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600 dark:text-gray-300">Plaka</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600 dark:text-gray-300">Saat</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600 dark:text-gray-300">Durum</th>
                        <th class="px-6 py-4 text-right text-sm font-semibold text-gray-600 dark:text-gray-300">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                    @foreach (var route in Model)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="font-semibold">@route.RouteName</div>
                                <div class="text-sm text-gray-500">@route.StartPoint → @route.EndPoint</div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-2 py-1 rounded-full text-xs
                                    @(route.VehicleType == "Taksi" ? "bg-yellow-100 text-yellow-700" :
                                      route.VehicleType == "Belediye Servisi" ? "bg-blue-100 text-blue-700" :
                                      "bg-green-100 text-green-700")">
                                    @route.VehicleType
                                </span>
                            </td>
                            <td class="px-6 py-4 font-mono text-sm">@route.PlateNumber</td>
                            <td class="px-6 py-4 text-sm">@route.DepartureTime - @route.ArrivalTime</td>
                            <td class="px-6 py-4">
                                <form asp-action="ToggleStatus" method="post" class="inline">
                                    <input type="hidden" name="id" value="@route.Id" />
                                    <button type="submit" class="px-3 py-1 rounded-full text-xs @(route.IsActive ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700")">
                                        @(route.IsActive ? "Aktif" : "Pasif")
                                    </button>
                                </form>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <a href="/Admin/EditRoute/@route.Id" class="p-2 text-blue-500 hover:bg-blue-50 dark:hover:bg-blue-900/30 rounded-lg transition-colors">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <form asp-action="DeleteRoute" method="post" class="inline" onsubmit="return confirm('Bu servisi silmek istediğinize emin misiniz?');">
                                    <input type="hidden" name="id" value="@route.Id" />
                                    <button type="submit" class="p-2 text-red-500 hover:bg-red-50 dark:hover:bg-red-900/30 rounded-lg transition-colors">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="text-center py-12 text-gray-500">
                    <i class="fas fa-bus text-4xl mb-4"></i>
                    <p>Henüz servis eklenmemiş.</p>
                </div>
            }
        </div>
    </div>
</div>
